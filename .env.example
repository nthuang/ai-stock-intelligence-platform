DATABASE_URL=postgresql://stock_user:stock_password@localhost:5432/stock_db
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional email destination; configure Gmail OAuth in n8n.
ALERT_EMAIL=you@example.com
# Calendar days, allowing weekends; not an exchange calendar.
MAX_DATA_AGE_DAYS=4
# Compose ingestion: demo (offline snapshot) or live (Yahoo Finance).
DATA_MODE=live

# Live API refresh interval, in seconds (minimum 10).
REFRESH_INTERVAL_SECONDS=60
