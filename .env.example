DATABASE_URL=postgresql://stock_user:stock_password@localhost:5432/stock_db
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional email destination; configure Gmail OAuth in n8n.
ALERT_EMAIL=you@example.com
# Calendar days, allowing weekends; not an exchange calendar.
MAX_DATA_AGE_DAYS=4
# Compose ingestion: demo (offline snapshot) or live (Yahoo Finance).
DATA_MODE=live

# Live API refresh interval, in seconds (minimum 10).
REFRESH_INTERVAL_SECONDS=60

# Optional free-tier Tavily news. Demo mode always disables external AI calls.
NEWS_ENABLED=false
TAVILY_API_KEY=replace_with_your_tavily_api_key
NEWS_MAX_RESULTS=5
# News must match the stock session date; older reports are not used.
NEWS_CACHE_TTL_SECONDS=21600
NEWS_DAILY_SEARCH_LIMIT=20
# Clamped to 900; default leaves headroom below a 1,000-credit monthly allowance.
NEWS_MONTHLY_SEARCH_LIMIT=500
NEWS_MAX_TICKERS_PER_REQUEST=2
NEWS_TIMEOUT_SECONDS=15
SUMMARY_CACHE_TTL_SECONDS=21600

# Existing stock-review host ports; n8n OAuth redirect follows N8N_PORT.
API_PORT=18000
POSTGRES_PORT=15432
N8N_PORT=5678

# Local live access stays on loopback. Public hosting supports the offline demo only.
DEPLOYMENT_MODE=local
# Required for internal notification endpoints; set a long random value in local .env.
NOTIFICATION_API_KEY=
