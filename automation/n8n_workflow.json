{
  "name": "AIStock",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 18
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "c9866006-4bb6-4ca9-a55f-2c632662bc3a",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "url": "http://api:8000/ai-summary/latest",
        "options": {
          "timeout": 240000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "eefe7751-2c12-43b5-9ad3-7a5d08c8ecaa",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c50ea468-882a-47b5-a99b-f6abee134b77",
              "leftValue": "={{$json[\"signals\"].length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "fresh-data-only",
              "leftValue": "={{$json[\"stale\"]}}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        416,
        0
      ],
      "id": "12b6df94-11c3-4541-90d9-99d85904a3ef",
      "name": "If"
    },
    {
      "parameters": {
        "sendTo": "={{$env.ALERT_EMAIL}}",
        "subject": "={{ \"Daily Market Intelligence ? \" + $(\"HTTP Request\").item.json.date }}",
        "message": "={{ $json.html }}",
        "options": {},
        "emailType": "html"
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1024,
        -32
      ],
      "id": "f17f403c-2385-44cc-b12f-aa606d27ea6a",
      "name": "Send a message",
      "webhookId": "ad7dc354-fc88-4851-b5d1-50eeb53a97bf"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notifications/claim",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({date: $json.date, recipient: $env.ALERT_EMAIL}) }}",
        "options": {
          "timeout": 240000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        608,
        -32
      ],
      "id": "daily-delivery-claim",
      "name": "Claim delivery"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "claim-allowed",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        816,
        -32
      ],
      "id": "daily-delivery-allowed",
      "name": "Delivery allowed"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notifications/complete",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({key: $(\"Claim delivery\").item.json.key, token: $(\"Claim delivery\").item.json.token}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1232,
        -32
      ],
      "id": "daily-delivery-complete",
      "name": "Record delivery",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "If",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If": {
      "main": [
        [
          {
            "node": "Claim delivery",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Claim delivery": {
      "main": [
        [
          {
            "node": "Delivery allowed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivery allowed": {
      "main": [
        [
          {
            "node": "Send a message",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Send a message": {
      "main": [
        [
          {
            "node": "Record delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": false,
    "timezone": "America/New_York"
  },
  "tags": []
}
